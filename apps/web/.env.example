# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical website origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=

# Optional comma-separated same-origin allowlist for previews
APP_ALLOWED_ORIGINS=

# Server-only random value (at least 32 characters) for rate-limit fingerprints
RATE_LIMIT_SALT=

# Server-only random value mirrored into Supabase Vault (never browser-exposed)
RATE_LIMIT_SECRET=

# Browser-public VAPID key used only for PushManager.subscribe
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only Supabase and Web Push delivery configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
DATABASE_WEBHOOK_SECRET=
