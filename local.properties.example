# Copy this entry to the ignored local.properties file.
# This is the Web OAuth client ID, not a client secret.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Public client configuration. Copy the publishable key from the approved
# Supabase project's API settings. Never use a secret/service-role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
